# ==============================================================================
# Environment Configuration: Team Recruitment Automation Tool
# ==============================================================================
# Architecture: Public, Anonymous, No-Login Web Application
# 
# The application runs immediately without any mandatory sign-up, login,
# user account, or Google OAuth setup. Anyone can upload candidate files,
# configure scoring criteria, run evaluations, and download RFC 4180 audit CSVs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# For local offline development (default fallback):
DATABASE_URL=sqlite:///./recruitment.db

# For Supabase PostgreSQL in production:
# Recommended: Supabase IPv4 Connection Pooler (Port 6543):
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. Anonymous Session & Public Upload Protection
# ------------------------------------------------------------------------------
# Max upload file size in bytes (defaults to 10 MB = 10485760)
MAX_UPLOAD_SIZE_BYTES=10485760

# HttpOnly session cookie name
SESSION_COOKIE_NAME=recruitment_session_id

# Set to true in production over HTTPS; false for local http://localhost
SESSION_COOKIE_SECURE=false

# SameSite cookie policy ('lax' recommended for standard browser navigation)
SESSION_COOKIE_SAMESITE=lax

# Session retention expiration in seconds (default: 7 days = 604800)
SESSION_MAX_AGE_SECONDS=604800

# ------------------------------------------------------------------------------
# 3. Core Application & Rule Engine Limits
# ------------------------------------------------------------------------------
DEBUG=false
API_V1_PREFIX=/api/v1
ENGINE_VERSION=2.0.0

# Team size boundaries
MIN_TEAM_SIZE=1
MAX_TEAM_SIZE=5

# ------------------------------------------------------------------------------
# 4. GitHub API Integration (Profile & Repository Enrichment)
# ------------------------------------------------------------------------------
# Your GitHub Personal Access Token (starts with ghp_ or github_pat_):
# Increases rate limit from 60 req/hr to 5,000 req/hr for looking up candidate GitHub metrics.
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
# GitHub API base endpoint (default: https://api.github.com)
GITHUB_URI=https://api.github.com
GITHUB_API_TIMEOUT=8.0

# ------------------------------------------------------------------------------
# 5. Optional: Supabase & Google OAuth (Only if Multi-Tenant Auth is desired)
# ------------------------------------------------------------------------------
# Neither Supabase Auth nor Google OAuth credentials are required for public operation.
# Leave commented out for standard anonymous operation:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY=eyJhbGciOi...
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
