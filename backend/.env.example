# ==============================================================================
# Environment Configuration: Team Recruitment Automation Tool
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the backend root directory (`cp .env.example .env`).
# 2. Fill in the values for your Supabase project, Google OAuth, and GitHub token.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# For local offline development (default fallback):
DATABASE_URL=sqlite:///./recruitment.db

# For Supabase PostgreSQL in production:
# Option A: Supabase Transaction Pooler (Recommended for cloud/serverless, Port 6543):
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Option B: Direct Connection (Session Mode, Port 5432):
# DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. Supabase Auth & Gateway Settings
# ------------------------------------------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / Public Key (Safe for frontend & public API requests):
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (CONFIDENTIAL: Keep secret on backend only, never expose to frontend):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase JWT Secret (Used by FastAPI to cryptographically verify user JWT signatures):
# Located in Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret:
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 Authentication
# ------------------------------------------------------------------------------
# How to obtain:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/) -> APIs & Services -> Credentials.
# 2. Create "OAuth 2.0 Client IDs" -> Web Application.
# 3. Set Authorized Redirect URI in Google Console to:
#    https://<your-project-ref>.supabase.co/auth/v1/callback
# 4. In Supabase Dashboard -> Authentication -> Providers -> Google:
#    Enable Google provider and paste your Client ID and Client Secret.
# 5. Add them below for backend configuration:
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 4. GitHub API Integration (Dushant's Profile Enrichment Service)
# ------------------------------------------------------------------------------
# Optional, but highly recommended: Increases rate limit from 60 req/hr to 5,000 req/hr.
# Generate a Personal Access Token (classic or fine-grained) with 'read:user' scope at:
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_API_TIMEOUT=8.0

# ------------------------------------------------------------------------------
# 5. Core Application & Rule Engine Limits
# ------------------------------------------------------------------------------
DEBUG=false
API_V1_PREFIX=/api/v1
ENGINE_VERSION=2.0.0

# Default team size boundaries
MIN_TEAM_SIZE=1
MAX_TEAM_SIZE=5
