# Environment Variables for Team Recruitment Automation Backend
# Copy to .env and adjust for local or production use

# Database connection:
# For local development with SQLite (default):
DATABASE_URL=sqlite:///./recruitment.db
# For Supabase PostgreSQL in production:
# Direct connection (port 5432):
# DATABASE_URL=postgresql://recruitment_backend:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# Or Supabase Transaction Pooler (port 6543, recommended for serverless/IPv4):
# DATABASE_URL=postgresql://recruitment_backend.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# Application Settings
DEBUG=false
API_V1_STR=/api/v1
ENGINE_VERSION=2.0.0

# Team Size Constraints
MIN_TEAM_SIZE=1
MAX_TEAM_SIZE=5
